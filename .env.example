# EC2에서 접속하려면 HOST를 0.0.0.0으로 바꾸세요.
HOST=127.0.0.1
PORT=3000
# 로컬은 SESSION_SECRET을 직접 입력하고, EC2는 Secrets Manager ID를 설정해 불러올 수 있습니다.
SESSION_SECRET=replace-with-a-long-random-secret-at-least-32-characters
SECRETS_MANAGER_SECRET_ID=

# RDS 연결 전: sqlite (파일 DB). RDS 연결 후: mysql
DB_MODE=sqlite
# 기본 SQLite 파일은 data/users.sqlite 입니다. 필요할 때만 경로를 지정하세요.
# SQLITE_PATH=/absolute/path/users.sqlite
DB_HOST=your-rds-endpoint.ap-northeast-2.rds.amazonaws.com
DB_PORT=3306
DB_NAME=whs_cloud9
DB_USER=whs_app
DB_PASSWORD=replace-me
# RDS TLS 인증서의 절대 경로. DB_MODE=mysql에서는 필수입니다.
DB_SSL_CA=

# 로컬 파일: local / S3 저장: s3
STORAGE_MODE=local
AWS_REGION=ap-northeast-2
S3_BUCKET=whs-cloud9-vuln-web-lab-896986966760-ap-northeast-2-an
S3_PREFIX=whs-uploads/
# SDK는 EC2 IAM 역할을 사용합니다. 소스 코드에 AWS 키를 넣지 마세요.

# SQLi / OS 인젝션 / SSRF는 기본 기능입니다. 별도의 실습 모드 스위치가 없습니다.
